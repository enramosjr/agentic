{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/shell_guard.py\"",
            "statusMessage": "Checking shell command",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/lifecycle.py\" hook",
            "statusMessage": "Checking lifecycle stage",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/lifecycle.py\" hook",
            "statusMessage": "Checking lifecycle stage",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/review_native.py\" hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/lifecycle.py\" hook",
            "statusMessage": "Loading lifecycle router",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/review_native.py\" hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/review_native.py\" hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/review_native.py\" hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.ai/scripts/review_native.py\" hook --adapter codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
